# 系统/编辑器临时文件
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp

# IDE
.idea/
.vscode/

# 操作系统
$RECYCLE.BIN/

# 数据备份（含 base64 图片，体积大，不入库）
备份_*.json

# 历史对话记录（含内网链接，只留本地，不入库）
docs/

# 本地敏感凭据 —— 绝不能推上 GitHub（推了会被自动扫描 + 秒撤销）
.local/
*.token
*.token.txt
.github-token

# 本地浏览器回归截图（只用于验收，不入库）
*-proof.png

# 本地回收站（删掉的旧页面先挪这儿，别用 git rm，中文路径会误删整个目录）
.trash/
